<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================
  PHO Website - IIS (web.config) Configuration
  =============================================================
  Place this file in the website root directory on a Windows
  Server running IIS. Requires the URL Rewrite module installed.
  
  Download URL Rewrite: https://www.iis.net/downloads/microsoft/url-rewrite
  =============================================================
-->
<configuration>
  <system.webServer>

    <!-- ---- Hide Server Version ---- -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ---- Prevent Directory Listing ---- -->
    <directoryBrowse enabled="false" />

    <!-- ---- Default Document ---- -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ---- Block Sensitive Files & Directories ---- -->
    <security>
      <requestFiltering>
        <!-- Block hidden segments like .git -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment="supabase" />
          <add segment="node_modules" />
        </hiddenSegments>
        <!-- Block sensitive file extensions -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".gitignore" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ---- Clean URLs (Requires URL Rewrite Module) ---- -->
    <rewrite>
      <rules>
        <!-- 1) Redirect /index.html to / -->
        <rule name="Redirect index.html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- 2) Redirect any .html request to clean URL
             e.g. /contact-us.html => /contact-us -->
        <rule name="Redirect .html to clean URL" stopProcessing="true">
          <match url="^(.+)\.html$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3) Serve clean URLs by rewriting to .html file
             e.g. /contact-us => serves contact-us.html -->
        <rule name="Serve clean URL from .html file" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- ---- Static Asset Caching ---- -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

  </system.webServer>
</configuration>
